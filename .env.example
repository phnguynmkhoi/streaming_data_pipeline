# Copy to .env and fill in real values. .env is NOT tracked by git --
# keep every real credential there, never in this file.

# Postgres (must match the postgres service in docker-compose.yml)
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=xxxxxxxx

# MinIO (must match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in docker-compose.yml)
MINIO_ACCESS_KEY=xxxxxxxx
MINIO_SECRET_KEY=xxxxxxxx

# Alertmanager email alerts (PLAN.md 4.1). Rendered into
# monitoring/alertmanager/alertmanager.yml by script/render_alertmanager_config.sh.
# Gmail requires a 16-character App Password (Google Account > Security >
# 2-Step Verification > App passwords), not your account password.
# Leave these unset to keep alerts in Prometheus only.
ALERT_EMAIL_TO=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
